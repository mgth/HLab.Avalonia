<UserControl x:Class="HLab.Mvvm.Application.Avalonia.DocumentPresenterView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:HLab.Icons.Avalonia.Icons;assembly=HLab.Icons.Avalonia"
             xmlns:lang="clr-namespace:HLab.Localization.Avalonia.Lang;assembly=HLab.Localization.Avalonia"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

            <!-- Fond gris des documents : parité avec le thème AvalonDock du WPF
                 (sans lui, le noir de la fenêtre rend les fiches trop contrastées). -->
            <TabControl Background="{DynamicResource HLab.Brushes.ThemeBackground}"
                        ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}">
                <TabControl.Styles>
                    <!-- Les items sont des VUES : un ContentPresenter n'applique pas de
                         template à un Control (et la vue est déjà affichée dans le contenu).
                         L'entête est donc le DataContext de la vue (son ViewModel), templaté
                         comme le DocumentHeaderTemplate d'AvalonDock côté WPF. -->
                    <Style Selector="TabItem">
                        <Setter Property="Header" Value="{Binding $self.Content.DataContext}"/>
                        <Setter Property="HeaderTemplate">
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:IconView IconMaxHeight="16" MaxHeight="16" Path="{Binding IconPath}"/>
                                        <lang:LocalizedLabel Margin="10,0,0,0" FontSize="14" FontWeight="Bold" Text="{Binding Header}"/>
                                    </StackPanel>
                                    <lang:LocalizedLabel FontSize="12" FontStyle="Italic"
                                        Text="{Binding SubTitle}"
                                        IsVisible="{Binding SubTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </Setter>
                    </Style>
                </TabControl.Styles>
            </TabControl>

</UserControl>
